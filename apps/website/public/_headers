# HTML — short cache, revalidate on every deploy
/*.html
  Cache-Control: public, max-age=3600, must-revalidate

/
  Cache-Control: public, max-age=3600, must-revalidate

# Hashed JS/CSS assets — immutable forever
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Static text files — moderate cache
/robots.txt
  Cache-Control: public, max-age=86400

/sitemap.xml
  Cache-Control: public, max-age=86400

/llms.txt
  Cache-Control: public, max-age=86400

/llms-full.txt
  Cache-Control: public, max-age=86400
